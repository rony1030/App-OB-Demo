# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required server-side for public landing translations. Never expose or prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Production Site URL for absolute links
NEXT_PUBLIC_SITE_URL=https://brokers.osvaldobello.com
NEXT_PUBLIC_APP_URL=https://brokers.osvaldobello.com

# Required for a stable self-hosted Next.js deployment. Generate this once and
# keep it unchanged between deploys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Protects the internal weekly translation-quality audit endpoint.
# Generate a separate long random value and never expose it in the browser.
CRON_SECRET=
TRANSLATION_AUDIT_BATCH_SIZE=12
TRANSLATION_AUDIT_MIN_AGE_DAYS=7

# Local-only fallback: renders the public landing page without catalog data
# when Supabase is unreachable. Ignored automatically in production.
LOCAL_SUPABASE_FALLBACK=false
LOCAL_CANA_ROCK_PREVIEW=false

# SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@osvaldobello.com
SMTP_PASS=
SMTP_FROM="OB Brokers Team" <no-reply@osvaldobello.com>
# Operational fallback recipients. Project-level recipients remain configurable
# inside the CRM and are used before this fallback.
AGENCY_REVIEW_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Server-only inventory connector. Never prefix the API key with NEXT_PUBLIC.
# Activate only after the current Cana Rock credential has been rotated.
GEMINI_API_KEY=
# Preferred production pool. The first healthy entry is used; the next entry is
# tried only after the active credential or its model fallbacks fail.
GEMINI_POOL=[]
# Server-only translation and quality-review fallback order. The first model
# that responds successfully is used and its result is persisted in Supabase.
GEMINI_TRANSLATION_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_INVENTORY_MODEL=gemini-2.5-flash
CANA_ROCK_AVAILABILITY_URL=https://portal.canarock.info
CANA_ROCK_AVAILABILITY_API_KEY=
